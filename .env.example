# ==============================================================================
# NEXUS ARCADE - Environment Configuration Template
# Works with local MongoDB or free MongoDB Atlas cluster
# ==============================================================================

# Server Port
PORT=3000

# Node Environment ('development' or 'production')
NODE_ENV=development

# MongoDB Connection String:
# Option A: Local MongoDB (default)
MONGODB_URI=mongodb://127.0.0.1:27017/gameportal

# Option B: MongoDB Atlas Free Tier (replace with your credentials):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/gameportal?retryWrites=true&w=majority

# JWT Authentication Secret for Admin Dashboard (use a strong random string in production)
JWT_SECRET=nexus_arcade_super_secret_jwt_key_2026_dev

# Admin Seed Defaults (created during `npm run seed`)
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=AdminPass123!

# Client / Domain URL for Dynamic Sitemap generation
SITE_URL=http://localhost:3000
